# 复制本文件为 os.env 后修改（os.env 不会提交到 Git）

# ========== 本地 LLM（答辩演示请用 local）==========
LLM_BACKEND=local
LOCAL_MODEL_PATH=/ai/data/lyr/muti-agent/models/Qwen2.5-3B-Instruct
LOCAL_MAX_NEW_TOKENS=2048
LOCAL_TEMPERATURE=0.7

# ========== 并发控制（任务队列 + 全局 LLM 槽位）==========
LLM_MAX_CONCURRENT=2
MAX_CONCURRENT_PIPELINES=3
TASK_QUEUE_MAX_DEPTH=0
# 兼容旧名（与 LLM_MAX_CONCURRENT 相同，可省略）
LOCAL_MAX_CONCURRENT=2

# ========== JWT ==========
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ========== 运行日志（调试/运维，写入 logs/app.log）==========
# LOG_DIR=/ai/data/lyr/muti-agent/logs
# LOG_LEVEL=INFO
# LOG_FILE_MAX_MB=10
# LOG_FILE_BACKUP_COUNT=5

# ========== 讨论期 → 收束期 ==========
MAX_DISCUSSION_USER_TURNS=30
DISCUSS_MAX_NEW_TOKENS=512
DISCUSS_HISTORY_MAX_MESSAGES=12
DISCUSS_INPUT_MAX_CHARS=12000
DISCUSSION_SUMMARY_MAX_NEW_TOKENS=1024
# LEGACY_AUTO_FINALIZE=1  # 设为 1 则创建后跳过讨论室（旧版一次性分析）

# ========== DeepSeek API（LLM_BACKEND=api 时才需要，课程验收勿用）==========
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://www.sophnet.com/api/open-apis/v1
# DEEPSEEK_MODEL=DeepSeek-V4-Flash
