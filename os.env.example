# 复制本文件为 os.env 后修改（os.env 不会提交到 Git）

# ========== 本地 LLM（答辩演示请用 local）==========
LLM_BACKEND=local
LOCAL_MODEL_PATH=/ai/data/lyr/muti-agent/models/Qwen2.5-3B-Instruct
LOCAL_MAX_NEW_TOKENS=2048
LOCAL_TEMPERATURE=0.7
LOCAL_MAX_CONCURRENT=2

# ========== JWT ==========
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ========== DeepSeek API（LLM_BACKEND=api 时才需要，课程验收勿用）==========
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://www.sophnet.com/api/open-apis/v1
# DEEPSEEK_MODEL=DeepSeek-V4-Flash
